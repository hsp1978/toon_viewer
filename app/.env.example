# Catalog mode: "komga" or "mock". Read at runtime, so a wrong value can be
# fixed with a restart. Leave it unset to infer from KOMGA_BASE_URL below.
# CATALOG_MODE=komga

# Deprecated: NEXT_PUBLIC_CATALOG_MODE is inlined at build time, so a build
# made with the wrong value stays wrong until rebuilt. CATALOG_MODE wins over
# it. Prefer CATALOG_MODE above for new setups.

KOMGA_BASE_URL=http://localhost:25600
KOMGA_API_KEY=
KOMGA_USERNAME=
KOMGA_PASSWORD=
KOMGA_FORCE_MOCK=false
KOMGA_MAX_LIST_PAGES=3
KOMGA_BOOTSTRAP_BOOK_LIMIT=40

# Required to delete a series. Deleting removes the files from disk and cannot
# be undone, so the route refuses every request while this is empty. Generate
# one with: openssl rand -hex 24
ADMIN_TOKEN=
