# Leave NEXT_PUBLIC_CATALOG_MODE=mock to run the UI without Komga.
# Remove it or set it to komga when KOMGA_BASE_URL is reachable.
NEXT_PUBLIC_CATALOG_MODE=mock

KOMGA_BASE_URL=http://localhost:25600
KOMGA_API_KEY=
KOMGA_USERNAME=
KOMGA_PASSWORD=
KOMGA_FORCE_MOCK=false
KOMGA_MAX_LIST_PAGES=3
KOMGA_BOOTSTRAP_BOOK_LIMIT=40
